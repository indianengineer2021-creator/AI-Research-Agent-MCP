# Required for Groq-hosted language models. Create a key at https://console.groq.com/
GROQ_API_KEY=

# Optional LangSmith tracing. Create a key at https://smith.langchain.com/
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent

# Optional if you switch to the Brave Search MCP server in mcp_servers.json.
BRAVE_API_KEY=

# Optional: use a different MCP JSON configuration path.
# MCP_CONFIG_PATH=mcp_servers.json

# Optional application logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
